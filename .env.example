DATABASE_URL="databaseURL"
JWT_SECRET="randomString"
PORT="port"
ANTHROPIC_API_KEY=

# Email các tài khoản quản trị (dashboard thống kê), ngăn cách bằng dấu phẩy. Để trống = không ai là admin.
ADMIN_EMAILS=

# Cấu hình Cổng Thanh Toán Tự Động SePay (sepay.vn)
# Webhook URL SePay gọi về: https://<your-domain>/api/payment/sepay-webhook
# Hoặc ngrok domain: https://flagstone-anchovy-concave.ngrok-free.dev/api/payment/sepay-webhook
SEPAY_ACC="5786666868888"
SEPAY_BANK="MBBank"
SEPAY_ACC_NAME="NGUYEN TIEN DAT"
# Khóa bí mật HMAC-SHA256 dạng whsec_... lấy trong mục Cấu hình HMAC-SHA256 trên SePay
SEPAY_SECRET_KEY="whsec_your_secret_key"
SEPAY_API_KEY=""
